  "integrated_changes": [
    "Private full/restricted roots per process with native lifecycle and injected allocation-failure checks.",
    "CPU-local GS entry state and VMM bindings; no boot-global CR3 pair.",
    "Shared user-return trampoline and task-stack IRQ frame transfer; BIOS/UEFI and diskless keyboard setup verified.",
    "Production root synchronizer tested as compiled C on host; obsolete global-CR3 source-string tests replaced."
  ],
  "remaining_gates": [
    "Minimal restricted-root mappings and full TLB/PCID isolation",
    "Nested faults/NMI/SWAPGS edge cases and multi-process/shared-VM execution",
    "SMP startup and broad physical hardware validation"
  ],
