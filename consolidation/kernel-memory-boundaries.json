{
  "status": "in_progress",
  "purpose": "Reconcile native memory and privilege-transition boundaries without dropping the baseline mitigation capability.",
  "baseline": "vos.v1",
  "decisions": [
    "Retain KPTI as a core isolation requirement. Earlier sources without kpti.c do not provide a replacement mitigation.",
    "Keep the canonical NX ELF copy alias and CPU-conditional SMAP instructions; native boot exposed failures in inherited code.",
    "Do not import old syscall entry wholesale: boot-global CR3 and syscall stack state require a per-process/per-CPU redesign, not removal of page-table isolation."
  ],
