{
  "name": "ai-code-review-webhook",
  "version": "1.0.0",
  "description": "AI Code Review Webhook Server - Multi-provider support with GitHub integration",
  "main": "dist/webhook_server.js",
  "scripts": {
    "dev": "tsx watch webhook_server.ts",
    "build": "tsc",
    "start": "node dist/webhook_server.js",
    "lint": "eslint . --ext .ts",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.125.0",
    "@octokit/rest": "22.0.1",
    "bull": "4.16.5",
    "express": "5.2.1",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@types/bull": "4.10.4",
    "@types/express": "5.0.6",
    "@types/node": "26.5.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "jest": "30.5.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "overrides": {
    "bull": {
      "uuid": "14.0.2"
    }
  }
}
