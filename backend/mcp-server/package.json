{
  "name": "v-os-mcp-agent-server",
  "version": "1.0.0",
  "description": "V OS MCP Agent Server - Production-grade multi-agent orchestration system",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "bin": {
    "v-os-mcp": "./dist/server.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:stdio": "TRANSPORT=stdio node dist/server.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector http://localhost:8080/mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "multi-agent",
    "llm",
    "v-os",
    "orchestration"
  ],
  "author": "V OS Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "fastmcp": "4.20.11",
    "zod": "4.6.4",
    "express": "5.2.1",
    "openai": "7.15.0",
    "@anthropic-ai/sdk": "0.125.0",
    "@azure/openai": "2.0.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.222.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "ioredis": "6.0.0",
    "ws": "8.21.3",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/express": "5.0.6",
    "@types/ws": "8.18.1",
    "typescript": "6.0.3",
    "tsx": "4.23.13",
    "vitest": "5.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/v-os/mcp-agent-server.git"
  }
}
