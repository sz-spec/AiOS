{
  "name": "v-os-mcp-agent-server",
  "version": "1.0.0",
  "description": "V OS MCP Agent Server - Production-grade multi-agent orchestration system",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "v-os-mcp": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:stdio": "TRANSPORT=stdio node dist/server.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector http://localhost:8080/mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "multi-agent",
    "llm",
    "v-os",
    "orchestration"
  ],
  "author": "V OS Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "fastmcp": "^3.23.0",
    "zod": "^3.25.0",
    "express": "^4.21.0",
    
    "openai": "^4.77.0",
    "@anthropic-ai/sdk": "^0.36.0",
    "@azure/openai": "^2.0.0",
    
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.211.0",
    "@opentelemetry/auto-instrumentations-node": "^0.69.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.211.0",
    
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "ioredis": "^5.4.0",
    "ws": "^8.18.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/v-os/mcp-agent-server.git"
  }
}
