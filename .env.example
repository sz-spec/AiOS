# VOS3 Environment Variables
# ==========================

# LLM API Keys (at least one required)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...

# Local LLM (optional — enables offline operation)
OLLAMA_BASE_URL=http://localhost:11434
VOS3_PREFERRED_PROVIDER=auto          # auto|anthropic|openai|local
VOS3_DEFAULT_CHAT_MODEL=claude-sonnet # Override default chat model
VOS3_FALLBACK_MODEL=claude-opus       # Override fallback model
VOS3_LOCALITY_PREFERENCE=auto         # local-first|cloud-first|auto
VOS3_LOCAL_MIN_PARAMS_B=70            # Minimum model size for agentic tasks (default: 70B)
VOS3_ALLOW_DEV_MODE=false             # Set true ONLY for local development (disables auth)

# Backend URL (for frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ──────────────────────────────────────────
# VOS_PROFILE — deployment profile gate
# Values: community | enterprise | fortress
# See docs/PROFILES.md for the full capability matrix.
# fortress requires VOS3_COMPLIANCE_KEY (SQLCipher passphrase).
# ──────────────────────────────────────────
VOS_PROFILE=community
# VOS3_COMPLIANCE_KEY=<set when VOS_PROFILE=fortress; SQLCipher passphrase>

# ──────────────────────────────────────────
# Convex (Database — single source of truth)
# ──────────────────────────────────────────
# Backend (Python FastAPI)
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=prod:...

# Frontend (Next.js)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# ──────────────────────────────────────────
# Authentication (Clerk)
# ──────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_ISSUER_URL=https://<your-clerk-domain>.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_...

# JWT Secret — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# Required by the production backend container. Generate a random value locally;
# no development handshake secret is printed to logs.
VOS3_TAURI_IPC_SECRET=

# ──────────────────────────────────────────
# Billing (Stripe)
# ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_TEAM_MONTHLY=price_...
STRIPE_PRICE_TEAM_YEARLY=price_...
STRIPE_PRICE_TOKENS_1000=price_...
STRIPE_PRICE_TOKENS_5000=price_...
STRIPE_PRICE_TOKENS_10000=price_...

# ──────────────────────────────────────────
# Observability (optional)
# ──────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=...
LANGFUSE_SECRET_KEY=...
LANGFUSE_HOST=https://cloud.langfuse.com
LANGSMITH_API_KEY=...
SENTRY_DSN=https://...

# ──────────────────────────────────────────
# Cost Optimization
# ──────────────────────────────────────────
COST_OPTIMIZATION_ENABLED=true
SMART_ROUTING_ENABLED=true
SEMANTIC_CACHE_ENABLED=true
MAX_COST_PER_REQUEST=0.50

# MCP Server Integration (V-OS-MCP-Agent-Server)
# When enabled, routes LLM calls through MCP server for:
# - Semantic caching (40-60% cost savings on repeated queries)
# - User quotas (per-user spending limits)
# - Smart routing (automatic model selection)
# - Cost tracking (real-time analytics)
MCP_ENABLED=false
MCP_SERVER_URL=http://localhost:8080

# ─── Runtime Environment (required in all envs) ───────────────────────────────
ENVIRONMENT=development          # Set to "production" in production deployments
VOS_API_SECRET=change_me         # Internal API secret for service-to-service auth
REDIS_URL=redis://localhost:6379  # Required for production rate limiting
STRIPE_API_VERSION=2024-06-20    # Stripe API version pin
