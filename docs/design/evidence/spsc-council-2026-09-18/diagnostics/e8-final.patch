diff --git a/user/include/council_getpid_diag.h b/user/include/council_getpid_diag.h
new file mode 100644
index 0000000..2591058
--- /dev/null
+++ b/user/include/council_getpid_diag.h
@@ -0,0 +1,49 @@
+#ifndef COUNCIL_GETPID_DIAG_H
+#define COUNCIL_GETPID_DIAG_H
+/* E8 diagnostic only. TSC units are not physical CPU cycles. */
+#define CE8_SAMPLE 0x434F554E45380001ULL
+#define CE8_START  0x434F554E45380002ULL
+#define CE8_STOP   0x434F554E45380003ULL
+#define CE8_N 10000
+static volatile unsigned long long ce8_samples[2][CE8_N][2];
+static unsigned long long ce8_overhead[1000];
+static inline unsigned long long ce8_tsc(void) {
+    unsigned lo, hi;
+    __asm__ volatile("rdtsc" : "=a"(lo), "=d"(hi) : : "memory");
+    return ((unsigned long long)hi << 32) | lo;
+}
+static inline long ce8_call(unsigned long long tag, unsigned long long t0) {
+    long r;
+    __asm__ volatile("syscall" : "=a"(r) : "a"(39L), "D"(tag), "S"(t0)
+                     : "rcx", "r11", "memory");
+    return r;
+}
+static void ce8_run(const char *stage) {
+    /* Touch all result storage before sampling. */
+    for (unsigned m=0;m<2;m++) for (unsigned i=0;i<CE8_N;i++) {
+        ce8_samples[m][i][0]=0; ce8_samples[m][i][1]=0;
+    }
+    printf("[COUNCIL-E8] begin stage=%s n=10000 warmup=100 order=off,on\n",stage);
+    for (unsigned i=0;i<1000;i++) {
+        unsigned long long a=ce8_tsc(), b=ce8_tsc(); ce8_overhead[i]=b-a;
+    }
+    for (unsigned m=0;m<2;m++) {
+        for (unsigned i=0;i<100;i++) (void)ce8_call(0,0);
+        if (m) (void)ce8_call(CE8_START,0);
+        for (unsigned i=0;i<CE8_N;i++) {
+            unsigned long long a=ce8_tsc();
+            (void)ce8_call(CE8_SAMPLE,a);
+            unsigned long long b=ce8_tsc();
+            ce8_samples[m][i][0]=a; ce8_samples[m][i][1]=b;
+        }
+        if (m) (void)ce8_call(CE8_STOP,0);
+    }
+    /* Printing occurs only after all samples; kernel dump also follows sampling. */
+    for (unsigned i=0;i<1000;i++)
+        printf("[COUNCIL-E8-O] %s %u %llu\n",stage,i,ce8_overhead[i]);
+    for (unsigned m=0;m<2;m++) for (unsigned i=0;i<CE8_N;i++)
+        printf("[COUNCIL-E8-U] %s %u %u %llu %llu\n",stage,m,i,
+               ce8_samples[m][i][0],ce8_samples[m][i][1]);
+    printf("[COUNCIL-E8] end stage=%s\n",stage);
+}
+#endif
