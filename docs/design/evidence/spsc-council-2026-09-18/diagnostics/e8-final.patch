+    vos3_task_t *cur=vos3_task_current();
+    if (!cur || cur->tid!=ce8_owner) return;
+    ce8_inflight=0;
+    if (frame->rax!=39 || frame->rdi!=CE8_SAMPLE) return;
+    if (ce8_n>=CE8_N) { ce8_dropped++; return; }
+    struct ce8_row *r=&ce8_rows[ce8_n++];
+    r->user_start=frame->rsi; r->wait=0; r->wait_start=0; r->switches=0;
+    for (unsigned i=0;i<7;i++) r->t[i]=0;
+    r->t[0]=ce8_clock(); ce8_inflight=1;
