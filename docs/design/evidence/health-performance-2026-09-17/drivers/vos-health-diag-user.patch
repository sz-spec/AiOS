+/* Diagnostic only: single-writer counters, published before done. */
+static volatile uint64_t g_diag_empty_periods;
+static inline uint64_t diag_tsc(void) {
+    unsigned lo, hi;
+    __asm__ volatile ("lfence; rdtsc" : "=a"(lo), "=d"(hi) :: "memory");
+    return ((uint64_t)hi << 32) | lo;
+}
+static void diag_syscall_cost(void) {
+    const unsigned calls = 4096;
+    unsigned long start_ms = get_uptime_ms();
+    uint64_t start = diag_tsc(), sink = 0;
+    for (unsigned i = 0; i < calls; i++) sink += (uint64_t)syscall0(SYS_GETTIME);
+    uint64_t time_cycles = diag_tsc() - start;
+    unsigned long time_ms = get_uptime_ms() - start_ms;
+    start_ms = get_uptime_ms(); start = diag_tsc();
+    for (unsigned i = 0; i < calls; i++) sink += (uint64_t)syscall0(39); /* GETPID */
+    uint64_t pid_cycles = diag_tsc() - start;
+    unsigned long pid_ms = get_uptime_ms() - start_ms;
+    printf("[HEALTH-DIAG] preclone calls=%u gettime_cycles=%lu gettime_ms=%lu getpid_cycles=%lu getpid_ms=%lu sink=%lu\n",
+           calls, (unsigned long)time_cycles, time_ms, (unsigned long)pid_cycles, pid_ms, (unsigned long)sink);
+}
 
