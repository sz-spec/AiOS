{
  "name": "vos3-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rimraf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "clean": "rimraf .next",
    "clean:all": "rimraf .next node_modules/.cache",
    "test": "vitest run",
    "convex:dev": "npx convex dev --typecheck=disable",
    "convex:deploy": "npx convex deploy",
    "convex:codegen": "npx convex codegen",
    "test:idor": "node convex/_test/idor_fuzz.mjs",
    "test:input-validation": "node convex/_test/input_validation_fuzz.mjs",
    "test:convex-fuzz": "npm run test:idor && npm run test:input-validation",
    "test:all-fuzz": "npm run test:convex-fuzz",
    "test:unit": "vitest run --project unit",
    "test:convex": "vitest run --project convex",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.2",
    "@codesandbox/sandpack-react": "2.20.0",
    "@codesandbox/sandpack-themes": "2.0.21",
    "@dagrejs/dagre": "3.1.1",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@tauri-apps/api": "2.11.1",
    "@xyflow/react": "12.11.6",
    "cmdk": "1.1.1",
    "convex": "1.45.0",
    "framer-motion": "13.2.0",
    "immer": "11.1.18",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "yjs": "13.6.32",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "convex-test": "0.0.58",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.0.1",
    "postcss": "8.5.28",
    "rimraf": "6.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.10"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
