# =============================================================================
# VOS3 Frontend — Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Convex (Database)
# https://dashboard.convex.dev → your deployment URL
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# -----------------------------------------------------------------------------
# Clerk (Authentication)
# https://dashboard.clerk.com → API Keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Sign-in / sign-up page URLs (Clerk default)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shared secret between frontend and backend (must match VOS_API_SECRET in backend)
VOS_API_SECRET=change-me-in-production

# -----------------------------------------------------------------------------
# Sentry (Error Tracking — optional)
# https://sentry.io → Settings → Projects → DSN
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# Stripe (Billing — optional)
# https://dashboard.stripe.com → Developers → API Keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
